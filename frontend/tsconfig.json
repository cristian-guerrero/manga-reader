{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/app/*"],
      "@app": ["src/app"],
      "@features/*": ["src/features/*"],
      "@features": ["src/features"],
      "@shared/*": ["src/shared/*"],
      "@shared": ["src/shared"],
      "@services/*": ["src/services/*"],
      "@services": ["src/services"],
      "@stores/*": ["src/stores/*"],
      "@stores": ["src/stores"],
      "@hooks/*": ["src/hooks/*"],
      "@hooks": ["src/hooks"],
      "@components/*": ["src/components/*"],
      "@components": ["src/components"],
      "@types/*": ["src/types/*"],
      "@types": ["src/types"],
      "@utils/*": ["src/utils/*"],
      "@utils": ["src/utils"],
      "@constants/*": ["src/constants/*"],
      "@constants": ["src/constants"],
      "@themes/*": ["src/themes/*"],
      "@themes": ["src/themes"],
      "@i18n/*": ["src/i18n/*"],
      "@i18n": ["src/i18n"],
      "@contexts/*": ["src/contexts/*"],
      "@contexts": ["src/contexts"]
    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
